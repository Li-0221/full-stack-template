# 本地进程直连 dev 数据库；将 dev.example.com 替换为 dev 服务器地址。
# 用户、密码、数据库名和端口与服务器 deploy/.env.dev 对应；连接不使用 TLS。
APP_SECRET_KEY=change-this-local-secret-before-use-123456
APP_DATABASE_URL=postgresql+psycopg://app_dev:app_dev@dev.example.com:54322/app_dev?sslmode=disable
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5176"]

BACKEND_PORT=8000
VITE_APP_BASE_PATH=/
VITE_DEV_PORT=5176
